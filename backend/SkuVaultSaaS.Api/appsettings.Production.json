{
  "Cors": {
    "AllowedOrigins": [
      "https://app.justsku.com",
      "https://justsku.com",
      "https://www.justsku.com"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST};Database=${DB_NAME};User=${DB_USER};Password=${DB_PASSWORD};Port=3306;Pooling=true;MinPoolSize=2;MaxPoolSize=20;ConnectionLifeTime=30;ConnectionTimeout=30;",
    "DemoConnection": "Server=${DB_HOST};Database=justsku_demo;User=${DB_USER};Password=${DB_PASSWORD};Port=3306;Pooling=true;MinPoolSize=2;MaxPoolSize=20;ConnectionLifeTime=30;ConnectionTimeout=30;"
  },
  "Seeding": {
    "Enabled": false,
    "UseDemo": false
  },
  "Encryption": {
    "Key": "${ENCRYPTION_KEY}",
    "IV": "${ENCRYPTION_IV}"
  },
  "SyncSettings": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "DelayStartMinutes": 5,
    "SpecificIntervals": {
      "TransactionsMinutes": 15,
      "InventoryMinutes": 30,
      "ProductsMinutes": 60,
      "LocationsMinutes": 120
    }
  },
  "EmailSettings": {
    "SmtpHost": "smtp.zeptomail.com",
    "SmtpPort": 587,
    "UseSsl": false,
    "Username": "emailapikey",
    "Password": "${EMAIL_PASSWORD}",
    "FromEmail": "info@justsku.com",
    "FromName": "JUSTSKU",
    "ReplyToEmail": "info@justsku.com"
  },
  "LowStockNotificationSettings": {
    "IsEnabled": true,
    "IntervalMinutes": 240,
    "NotificationEmails": ["info@justsku.com"],
    "CheckIntervalMinutes": 240,
    "StartupDelayMinutes": 10,
    "DefaultThresholdQuantity": 10
  },
  "Stripe": {
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY}",
    "SecretKey": "${STRIPE_SECRET_KEY}",
    "WebhookSecret": "${STRIPE_WEBHOOK_SECRET}",
    "PriceIds": {
      "standard_monthly": "price_1SmJ6qP5Qbqd0Q9kvVqXO03J",
      "premium_monthly": "price_1SmJ6oP5Qbqd0Q9kObBTs62o",
      "enterprise_monthly": "price_1SmJ6lP5Qbqd0Q9kLDeoSKWf"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "Microsoft.AspNetCore.Routing": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "SkuVaultSaaS": "Debug",
      "SkuVaultSaaS.Api": "Debug",
      "SkuVaultSaaS.Api.Controllers": "Debug",
      "SkuVaultSaaS.Api.Controllers.ContactController": "Debug",
      "SkuVaultSaaS.Api.Services": "Debug",
      "SkuVaultSaaS.Infrastructure.Services": "Debug",
      "SkuVaultSaaS.Infrastructure.Services.EmailService": "Debug"
    }
  },
  "SeedDatabase": false,
  "SeedAdmin": {
    "Email": "${ADMIN_EMAIL}",
    "Password": "${ADMIN_PASSWORD}"
  },
  "AllowedHosts": "${ALLOWED_HOSTS}",
  "Jwt": {
    "Key": "prod-jwt-key-32-characters-minimum-length-secure-production",
    "Issuer": "JUSTSKU.Production",
    "Audience": "JUSTSKU.Clients",
    "ExpiresMinutes": 60
  }
}
