{
  "ConnectionStrings": {
    "DefaultConnection": "Server=ftp.davidbaumann.pro;Database=${DB_NAME};User=${DB_USER};Password=${DB_PASSWORD};Port=3306;"
  },
  "Encryption": {
    "Key": "${ENCRYPTION_KEY}",
    "IV": "${ENCRYPTION_IV}"
  },
  "SyncSettings": {
    "Enabled": true,
    "IntervalMinutes": 45,
    "DelayStartMinutes": 3,
    "SpecificIntervals": {
      "TransactionsMinutes": 10,
      "InventoryMinutes": 20,
      "ProductsMinutes": 45,
      "LocationsMinutes": 90
    }
  },
  "EmailSettings": {
    "SmtpHost": "mail.davidbaumann.pro",
    "SmtpPort": 465,
    "UseSsl": true,
    "Username": "app@davidbaumann.pro",
    "Password": "${EMAIL_PASSWORD}",
    "FromEmail": "app@davidbaumann.pro",
    "FromName": "JUSTSKU UAT - Low Stock Notifications"
  },
  "LowStockNotificationSettings": {
    "IsEnabled": true,
    "IntervalMinutes": 120,
    "NotificationEmails": ["uat@example.com"],
    "CheckIntervalMinutes": 120,
    "StartupDelayMinutes": 5,
    "DefaultThresholdQuantity": 10
  },
  "Stripe": {
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY}",
    "SecretKey": "${STRIPE_SECRET_KEY}",
    "WebhookSecret": "${STRIPE_WEBHOOK_SECRET}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "SeedDatabase": false,
  "AllowedHosts": "${ALLOWED_HOSTS}",
  "CORS": {
    "AllowedOrigins": ["${FRONTEND_URL}"]
  },
  "Jwt": {
    "Key": "uat-jwt-key-32-characters-minimum-length-secure",
    "Issuer": "JUSTSKU.UAT",
    "Audience": "JUSTSKU.UATClients",
    "ExpiresMinutes": 120
  }
}