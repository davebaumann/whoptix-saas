{
  "Cors": {
    "AllowedOrigins": [
      "https://app.justsku.com",
      "https://justsku.com",
      "https://www.justsku.com"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST};Database=${DB_NAME};User=${DB_USER};Password=${DB_PASSWORD};Port=3306;Pooling=true;MinPoolSize=2;MaxPoolSize=20;ConnectionLifeTime=30;ConnectionTimeout=30;",
    "DemoConnection": "Server=${DB_HOST};Database=justsku_demo;User=${DB_USER};Password=${DB_PASSWORD};Port=3306;Pooling=true;MinPoolSize=2;MaxPoolSize=20;ConnectionLifeTime=30;ConnectionTimeout=30;"
  },
  "Seeding": {
    "Enabled": false,
    "UseDemo": false
  },
  "Encryption": {
    "Key": "${ENCRYPTION_KEY}",
    "IV": "${ENCRYPTION_IV}"
  },
  "SyncSettings": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "DelayStartMinutes": 5,
    "SpecificIntervals": {
      "TransactionsMinutes": 15,
      "InventoryMinutes": 30,
      "ProductsMinutes": 60,
      "LocationsMinutes": 120
    }
  },
    "EmailSettings": {
    "SmtpHost": "email-smtp.us-east-1.amazonaws.com",
    "SmtpPort": "465",
    "UseSsl": "true",
    "Username": "AKIAUW6IAQK3623IUIN2",
    "Password": "${EMAIL_PASSWORD}",
    "FromName": "JUSTSKU",
    "ReplyToEmail": "info@justsku.com",
    "Emails": {
      "Verification": "noreply@justsku.com",
      "LowStockNotification": "notifications@justsku.com",
      "Support": "support@justsku.com"
    }
  },
  "LowStockNotificationSettings": {
