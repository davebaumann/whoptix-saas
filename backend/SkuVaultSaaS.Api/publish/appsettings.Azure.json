{
  "ConnectionStrings": {
    "DefaultConnection": "Server=ftp.davidbaumann.pro;Database=whoptix_azure;User=azure_user;Password=${DB_PASSWORD};Port=3306;"
  },
  "Encryption": {
    "Key": "${ENCRYPTION_KEY}",
    "IV": "${ENCRYPTION_IV}"
  },
  "SyncSettings": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "DelayStartMinutes": 5,
    "SpecificIntervals": {
      "TransactionsMinutes": 15,
      "InventoryMinutes": 30,
      "ProductsMinutes": 60,
      "LocationsMinutes": 120
    }
  },
  "EmailSettings": {
    "SmtpHost": "mail.davidbaumann.pro",
    "SmtpPort": 465,
    "UseSsl": true,
    "Username": "app@davidbaumann.pro",
    "Password": "${EMAIL_PASSWORD}",
    "FromEmail": "app@davidbaumann.pro",
    "FromName": "SkuVault Azure - Low Stock Notifications"
  },
  "LowStockNotificationSettings": {
    "IsEnabled": true,
    "IntervalMinutes": 240,
    "NotificationEmails": ["azure@example.com"],
    "CheckIntervalMinutes": 240,
    "StartupDelayMinutes": 5,
    "DefaultThresholdQuantity": 10
  },
  "Stripe": {
    "PublishableKey": "${STRIPE_PUBLISHABLE_KEY}",
    "SecretKey": "${STRIPE_SECRET_KEY}",
    "WebhookSecret": "${STRIPE_WEBHOOK_SECRET}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "SeedDatabase": false,
  "AllowedHosts": "${ALLOWED_HOSTS}",
  "CORS": {
    "AllowedOrigins": ["${FRONTEND_URL}"]
  },
  "Jwt": {
    "Key": "azure-jwt-key-32-characters-minimum-length-secure",
    "Issuer": "SkuVaultSaaS.Azure",
    "Audience": "SkuVaultSaaS.AzureClients",
    "ExpiresMinutes": 120
  }
}