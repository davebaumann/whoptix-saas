# Environment Variables Template
# Copy this to .env and fill in actual values
# Add .env to .gitignore - NEVER commit actual secrets

# ============ Database ============
DB_NAME=skuvault_dev
DB_USER=admin
DB_PASSWORD=your_password_here
DB_HOST=ftp.davidbaumann.pro

# Demo Database (UAT/Production)
DEMO_DB_HOST=ftp.davidbaumann.pro
DEMO_DB_USER=demo_user
DEMO_DB_PASSWORD=demo_password

# ============ Encryption ============
ENCRYPTION_KEY=your_encryption_key_here_at_least_32_chars
ENCRYPTION_IV=your_encryption_iv_16_chars

# ============ Stripe (Test/Production Keys) ============
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_actual_key_here
STRIPE_SECRET_KEY=sk_test_your_actual_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============ Email ============
EMAIL_PASSWORD=your_email_password_here

# ============ Frontend URL ============
FRONTEND_URL=http://localhost:5173

# ============ Allowed Hosts ============
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============ JWT ============
JWT_KEY=your_jwt_secret_key_here_at_least_32_characters
